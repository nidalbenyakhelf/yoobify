# yoobify Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ===========================================
# GitHub Configuration
# ===========================================
GITHUB_REPO=nidalbenyakhelf/yoobify

# ===========================================
# Deezer API (No keys required - public API)
# ===========================================
DEEZER_API_BASE=https://api.deezer.com
DEEZER_RATE_LIMIT=50
DEEZER_RATE_LIMIT_WINDOW=5000

# ===========================================
# Spotify API (Future - requires OAuth2)
# ===========================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback
SPOTIFY_API_BASE=https://api.spotify.com/v1

# ===========================================
# Apple Music API (Future)
# ===========================================
APPLE_MUSIC_DEVELOPER_TOKEN=your_apple_music_token_here
APPLE_MUSIC_API_BASE=https://api.music.apple.com/v1

# ===========================================
# YouTube Music API (Future)
# ===========================================
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# ===========================================
# SoundCloud API (Future)
# ===========================================
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_API_BASE=https://api.soundcloud.com

# ===========================================
# Anghami API (Future)
# ===========================================
ANGHAMI_API_KEY=your_anghami_api_key_here
ANGHAMI_API_BASE=https://api.anghami.com

# ===========================================
# Firebase (Future - for user accounts)
# ===========================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ===========================================
# Analytics (Future)
# ===========================================
GOOGLE_ANALYTICS_ID=your_ga_id_here
